##################################
# ********* App Config ********* #
##################################
# App Configuration (canonical origin for Open Graph URLs and /api/draft redirects behind a proxy)
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_SHOW_LOGGER=""
# Directus Configuration
NEXT_PUBLIC_DIRECTUS_URL=""
# Also used server-side to stream private files via /api/cms/assets/*
DIRECTUS_API_TOKEN=""
# Used by the live preview / draft mode route handler
DIRECTUS_PREVIEW_SECRET=""

##################################
# ******** Contact Form ******** #
##################################
# Mailbox that receives new enquiries
CONTACT_FORM_RECEIVE_EMAIL=""
# Sender address (e.g. no-reply@duecker-medizintechnik.de). Falls back to
# no-reply@CONTACT_FORM_SEND_EMAIL_DOMAIN when empty.
CONTACT_FORM_FROM_EMAIL=""
CONTACT_FORM_SEND_EMAIL_DOMAIN=""
# Secret for the self-hosted ALTCHA spam protection (generate with
# `openssl rand -hex 32`). Optional: derived from SMTP_PASSWORD when empty.
ALTCHA_HMAC_SECRET=""
# SMTP Configuration (port 465 = TLS, 587 = STARTTLS)
SMTP_HOST=""
SMTP_PORT=""
# Use a real mailbox: bounces are delivered here
SMTP_USER=""
SMTP_PASSWORD=""
# Only set to "false" if the SMTP server has no valid TLS certificate
SMTP_TLS_REJECT_UNAUTHORIZED=""

##################################
# ******* Service Config ******* #
##################################
# ... with Datadog
NEXT_PUBLIC_DATADOG_APPLICATION_ID=""
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=""
# ... with Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# ... with Hotjar
NEXT_PUBLIC_HOTJAR_ID=""
# ... with Sentry
SENTRY_AUTH_TOKEN=""
